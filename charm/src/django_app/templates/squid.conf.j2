# Generated by terrasquid
# Config version: {{ version }}
# DO NOT EDIT — managed by the Terrasquid charm

http_port {{ squid_port }}
coredump_dir /var/spool/squid

# ======= Source ACLs =======
{% for src in source_acls %}
acl src__{{ src.service }}__{{ src.name }} src {{ src.cidr | join(' ') }}
{% endfor %}

# ======= Source Groups =======
{% for grp in source_groups %}
{% for member in grp.sources.all() %}
acl srcgrp__{{ grp.service }}__{{ grp.name }} src {{ member.cidr | join(' ') }}
{% endfor %}
{% endfor %}

# ======= Destination ACLs =======
{% for dst in destination_configs %}
{% if dst.is_cidr %}
acl dst__{{ dst.service }}__{{ dst.name }} dst {{ dst.dst }}
{% else %}
acl dst__{{ dst.service }}__{{ dst.name }} dstdomain {{ dst.dst }}
{% endif %}
acl dstport__{{ dst.service }}__{{ dst.name }} port {{ dst.effective_ports() | join(' ') }}
{% endfor %}

# ======= Destination Groups =======
{% for grp in destination_groups %}
{% for member in grp.destinations.all() %}
{% if member.is_cidr %}
acl dstgrp__{{ grp.service }}__{{ grp.name }} dst {{ member.dst }}
{% else %}
acl dstgrp__{{ grp.service }}__{{ grp.name }} dstdomain {{ member.dst }}
{% endif %}
{% endfor %}
{% endfor %}

# ======= Port Groups =======
{% for pg in port_groups %}
acl portgrp__{{ pg.service }}__{{ pg.name }} port {{ pg.ports | join(' ') }}
{% endfor %}

# ======= ACL Rules (ordered by priority) =======
{% for rule in acl_rules %}
{% if rule.src %}
{% set src_acl = 'src__' + rule.src.service + '__' + rule.src.name %}
{% else %}
{% set src_acl = 'srcgrp__' + rule.src_group.service + '__' + rule.src_group.name %}
{% endif %}
{% if rule.dst %}
{% set dst_acl = 'dst__' + rule.dst.service + '__' + rule.dst.name %}
{% set port_acl = 'dstport__' + rule.dst.service + '__' + rule.dst.name %}
{% set action = 'allow' if rule.dst.type in ('ALLOW', 'CONNECT') else 'deny' %}
http_access {{ action }} {{ src_acl }} {{ dst_acl }} {{ port_acl }}
{% else %}
{% set dst_acl = 'dstgrp__' + rule.dst_group.service + '__' + rule.dst_group.name %}
http_access allow {{ src_acl }} {{ dst_acl }}
{% endif %}
{% endfor %}

# Default deny
http_access deny all
